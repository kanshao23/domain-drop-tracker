# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or real secrets — this template ships placeholders only.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # anon / public key (safe to expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=       # service_role (secret) — server only, bypasses RLS

# ─── Stripe ─────────────────────────────────────────────────────────────────
# 1. Create product "DomainDrop Pro" at stripe.com/dashboard
# 2. Add a recurring price (e.g. $5.00/month)
# 3. Copy the price ID (starts with price_...)
# 4. Add webhook endpoint: https://YOUR-DOMAIN/api/stripe-webhook
#    Events: customer.subscription.created / updated / deleted
STRIPE_SECRET_KEY=                    # sk_live_... or sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # pk_live_... or pk_test_...
STRIPE_PRO_PRICE_ID=                  # price_...
STRIPE_WEBHOOK_SECRET=                # whsec_... (from the Stripe webhook page)

# ─── Resend ──────────────────────────────────────────────────────────────────
# 1. Create an account at resend.com
# 2. Verify your sending domain (or use onboarding@resend.dev for testing)
# 3. Create an API key with "Full access"
RESEND_API_KEY=                       # re_...

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # your production URL in prod
# Secret guarding the /api/cron endpoint. Generate one with:
#   openssl rand -hex 32
CRON_SECRET=                          # long random string
