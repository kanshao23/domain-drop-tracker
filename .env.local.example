# ─── Stripe ─────────────────────────────────────────────────────────────────
# 1. Create product "DomainDrop Pro" at stripe.com/dashboard
# 2. Add price: $5.00/month recurring
# 3. Copy price ID (starts with price_...)
# 4. Set up webhook endpoint: https://domaindrop.watch/api/stripe-webhook
#    Events: customer.subscription.created/updated/deleted
STRIPE_SECRET_KEY=            # sk_live_... or sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # pk_live_... or pk_test_...
STRIPE_PRO_PRICE_ID=          # price_...
STRIPE_WEBHOOK_SECRET=        # whsec_... (from Stripe webhook page)

# ─── Resend ──────────────────────────────────────────────────────────────────
# 1. Create account at resend.com
# 2. Add domain: domaindrop.watch (or use onboarding@resend.dev for testing)
# 3. Create API key with "Full access"
RESEND_API_KEY=               # re_...

# ─── App ─────────────────────────────────────────────────────────────────────
